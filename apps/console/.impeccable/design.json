  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Implemented primary action treatment; preserves hover, focus, pressed and disabled states.",
      "html": "<button class=\"ds-button-primary\" type=\"button\">Change password</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:0 10px;border:1px solid transparent;border-radius:10px;font:500 14px/20px \"Figtree Variable\",sans-serif;white-space:nowrap;cursor:pointer;transition:background-color 150ms,color 150ms,border-color 150ms,box-shadow 150ms,transform 150ms;background:var(--primary,#a44228);color:var(--primary-foreground,#fff);}.ds-button-primary:hover{background:color-mix(in oklab,var(--primary,#a44228) 80%,transparent);}.ds-button-primary:focus-visible{outline:none;border-color:var(--ring,#8b4e37);box-shadow:0 0 0 3px color-mix(in srgb,var(--ring,#8b4e37) 50%,transparent);}.ds-button-primary:active{transform:translateY(1px);}.ds-button-primary:disabled{opacity:.5;pointer-events:none;}.ds-button-primary svg{width:16px;height:16px;flex-shrink:0;}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none;}}"
    },
    {
      "name": "Outline button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Implemented outline action treatment; preserves hover, focus, pressed and disabled states.",
      "html": "<button class=\"ds-button-outline\" type=\"button\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 12a9 9 0 0 1 15-6.7L21 8\"/><path d=\"M21 3v5h-5\"/><path d=\"M21 12a9 9 0 0 1-15 6.7L3 16\"/><path d=\"M8 16H3v5\"/></svg>Refresh</button>",
      "css": ".ds-button-outline{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:0 10px;border:1px solid transparent;border-radius:10px;font:500 14px/20px \"Figtree Variable\",sans-serif;white-space:nowrap;cursor:pointer;transition:background-color 150ms,color 150ms,border-color 150ms,box-shadow 150ms,transform 150ms;background:var(--background,#f7f7f0);color:var(--foreground,#222a25);border-color:var(--border,#d6ddce);}.ds-button-outline:hover{background:var(--muted,#edf0e5);}.ds-button-outline:focus-visible{outline:none;border-color:var(--ring,#8b4e37);box-shadow:0 0 0 3px color-mix(in srgb,var(--ring,#8b4e37) 50%,transparent);}.ds-button-outline:active{transform:translateY(1px);}.ds-button-outline:disabled{opacity:.5;pointer-events:none;}.ds-button-outline svg{width:16px;height:16px;flex-shrink:0;}:host-context(.dark) .ds-button-outline{background:color-mix(in oklab,var(--input,#52664f) 30%,transparent);border-color:var(--input,#52664f);}:host-context(.dark) .ds-button-outline:hover{background:color-mix(in oklab,var(--input,#52664f) 50%,transparent);}@media(prefers-reduced-motion:reduce){.ds-button-outline{transition:none;}}"
    },
    {
      "name": "Ghost button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Implemented ghost action treatment; preserves hover, focus, pressed and disabled states.",
      "html": "<button class=\"ds-button-ghost\" type=\"button\">Use dark theme</button>",
      "css": ".ds-button-ghost{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:0 10px;border:1px solid transparent;border-radius:10px;font:500 14px/20px \"Figtree Variable\",sans-serif;white-space:nowrap;cursor:pointer;transition:background-color 150ms,color 150ms,border-color 150ms,box-shadow 150ms,transform 150ms;background:transparent;color:var(--foreground,#222a25);}.ds-button-ghost:hover{background:var(--muted,#edf0e5);}.ds-button-ghost:focus-visible{outline:none;border-color:var(--ring,#8b4e37);box-shadow:0 0 0 3px color-mix(in srgb,var(--ring,#8b4e37) 50%,transparent);}.ds-button-ghost:active{transform:translateY(1px);}.ds-button-ghost:disabled{opacity:.5;pointer-events:none;}.ds-button-ghost svg{width:16px;height:16px;flex-shrink:0;}@media(prefers-reduced-motion:reduce){.ds-button-ghost{transition:none;}}:host-context(.dark) .ds-button-ghost:hover{background:color-mix(in oklab,var(--muted,#26362c) 50%,transparent);}"
    },
    {
      "name": "Destructive button",
      "kind": "button",
      "refersTo": "button-destructive",
      "description": "Implemented destructive action treatment; preserves hover, focus, pressed and disabled states.",
      "html": "<button class=\"ds-button-destructive\" type=\"button\">Revoke identity</button>",
      "css": ".ds-button-destructive{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:0 10px;border:1px solid transparent;border-radius:10px;font:500 14px/20px \"Figtree Variable\",sans-serif;white-space:nowrap;cursor:pointer;transition:background-color 150ms,color 150ms,border-color 150ms,box-shadow 150ms,transform 150ms;background:color-mix(in oklab,var(--destructive,#ad3d35) 10%,transparent);color:var(--destructive,#ad3d35);}.ds-button-destructive:hover{background:color-mix(in oklab,var(--destructive,#ad3d35) 20%,transparent);}.ds-button-destructive:focus-visible{outline:none;border-color:color-mix(in oklab,var(--destructive,#ad3d35) 40%,transparent);box-shadow:0 0 0 3px color-mix(in srgb,var(--destructive,#ad3d35) 20%,transparent);}.ds-button-destructive:active{transform:translateY(1px);}.ds-button-destructive:disabled{opacity:.5;pointer-events:none;}.ds-button-destructive svg{width:16px;height:16px;flex-shrink:0;}:host-context(.dark) .ds-button-destructive{background:color-mix(in oklab,var(--destructive,#f29c91) 20%,transparent);}:host-context(.dark) .ds-button-destructive:hover{background:color-mix(in oklab,var(--destructive,#f29c91) 30%,transparent);}@media(prefers-reduced-motion:reduce){.ds-button-destructive{transition:none;}}:host-context(.dark) .ds-button-destructive:focus-visible{box-shadow:0 0 0 3px color-mix(in srgb,var(--destructive,#f29c91) 40%,transparent);}"
    },
    {
      "name": "Labeled search field",
      "kind": "input",
      "refersTo": "input",
      "description": "Compact environment search with a visible label and inline SVG; input becomes 16px on narrow screens.",
      "html": "<label class=\"ds-search-label\" for=\"ds-environment-search\">Find an environment</label><div class=\"ds-search\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg><input id=\"ds-environment-search\" class=\"ds-search-input\" placeholder=\"Find an environment…\" /></div>",
      "css": ".ds-search-label{display:block;margin-bottom:8px;color:var(--foreground,#222a25);font:500 14px/20px \"Figtree Variable\",sans-serif;}.ds-search{position:relative;width:100%;max-width:320px;}.ds-search svg{position:absolute;left:10px;top:8px;width:16px;height:16px;color:var(--muted-foreground,#5b665b);pointer-events:none;}.ds-search-input{width:100%;height:32px;min-width:0;padding:4px 10px 4px 32px;border:1px solid var(--input,#bdc9b7);border-radius:10px;background:transparent;color:var(--foreground,#222a25);font:400 14px/20px \"Figtree Variable\",sans-serif;transition:border-color 150ms,box-shadow 150ms;}.ds-search-input::placeholder{color:var(--muted-foreground,#5b665b);}.ds-search-input:focus-visible{outline:none;border-color:var(--ring,#8b4e37);box-shadow:0 0 0 3px color-mix(in srgb,var(--ring,#8b4e37) 50%,transparent);}.ds-search-input:disabled{opacity:.5;cursor:not-allowed;background:color-mix(in oklab,var(--input,#bdc9b7) 50%,transparent);}.ds-search-input[aria-invalid=\"true\"]{border-color:var(--destructive,#ad3d35);box-shadow:0 0 0 3px color-mix(in srgb,var(--destructive,#ad3d35) 20%,transparent);}:host-context(.dark) .ds-search-input{background:color-mix(in oklab,var(--input,#52664f) 30%,transparent);}@media(max-width:767px){.ds-search-input{font-size:16px;}}@media(prefers-reduced-motion:reduce){.ds-search-input{transition:none;}}"
    },
    {
      "name": "Forest rail navigation",
      "kind": "nav",
      "refersTo": "rail-navigation",
      "description": "Two actual rail destinations show active, hover and keyboard-focus states.",
      "html": "<nav class=\"ds-rail\" aria-label=\"Example workspace navigation\"><a class=\"ds-rail-link\" href=\"#overview\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/></svg>Overview</a><a class=\"ds-rail-link\" href=\"#projects\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 20H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h5l2 2h9a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2Z\"/></svg>Projects</a></nav>",
      "css": ".ds-rail{display:flex;flex-direction:column;gap:5px;width:220px;padding:16px;background:var(--rail,#213d32);font:500 14px/21px \"Figtree Variable\",sans-serif;}.ds-rail-link{display:flex;align-items:center;gap:12px;min-height:42px;padding:10px 13px;border-radius:6px;color:var(--rail-muted,#bccdbd);text-decoration:none;}.ds-rail-link svg{width:18px;height:18px;flex-shrink:0;}.ds-rail-link:hover{background:color-mix(in srgb,var(--rail,#213d32) 80%,white);color:var(--rail-foreground,#eff3e9);}.ds-rail-link[aria-current=\"page\"]{background:var(--rail-active,#e8edd9);color:#213d32;font-weight:650;}.ds-rail-link:focus-visible{outline:2px solid var(--ring,#8b4e37);outline-offset:3px;}"
    },
    {
      "name": "Labeled health badges",
      "kind": "chip",
      "refersTo": "status",
      "description": "The implemented green, ochre and red health pairs always retain readable state labels.",
      "html": "<div class=\"ds-status-group\"><span class=\"ds-status ds-status-success\"><span class=\"ds-status-dot\" aria-hidden=\"true\"></span>Ready</span><span class=\"ds-status ds-status-warning\"><span class=\"ds-status-dot\" aria-hidden=\"true\"></span>Blocked</span><span class=\"ds-status ds-status-failure\"><span class=\"ds-status-dot\" aria-hidden=\"true\"></span>Failed</span></div>",
      "css": ".ds-status-group{display:flex;flex-wrap:wrap;gap:8px;}.ds-status{display:inline-flex;align-items:center;justify-content:center;gap:4px;height:20px;padding:2px 8px;border:1px solid transparent;border-radius:32px;white-space:nowrap;font:500 12px/16px \"Figtree Variable\",sans-serif;}.ds-status-dot{width:5px;height:5px;border-radius:50%;background:currentColor;}.ds-status-success{color:var(--success,#237043);background:var(--success-surface,#e8f1e7);}.ds-status-warning{color:var(--warning,#805510);background:var(--warning-surface,#fbf0d7);}.ds-status-failure{color:var(--failure,#a33730);background:var(--failure-surface,#f8e9e4);}"
    },
    {
      "name": "Record panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "The shared flat panel joins toolbar, record content and a muted provenance footer.",
      "html": "<section class=\"ds-panel\" aria-label=\"Example environment record\"><div class=\"ds-panel-toolbar\"><strong>Environments</strong><span>1 environment shown</span></div><div class=\"ds-panel-row\"><strong>sample</strong><span>Staging</span></div><div class=\"ds-panel-footer\">Health is matched to the selected generation</div></section>",
      "css": ".ds-panel{max-width:580px;overflow:hidden;border:1px solid var(--border,#d6ddce);border-radius:12px;background:var(--card,#fdfdf8);color:var(--foreground,#222a25);font:400 14px/21px \"Figtree Variable\",sans-serif;}.ds-panel-toolbar{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;padding:14px 16px;border-bottom:1px solid var(--border,#d6ddce);}.ds-panel-toolbar strong{font-weight:600;}.ds-panel-toolbar span{color:var(--muted-foreground,#5b665b);font-size:12px;}.ds-panel-row{display:flex;justify-content:space-between;gap:20px;padding:18px 20px;}.ds-panel-row strong{font-weight:500;}.ds-panel-footer{display:flex;flex-wrap:wrap;gap:12px;padding:9px 16px;border-top:1px solid var(--border,#d6ddce);background:var(--muted,#edf0e5);color:var(--muted-foreground,#5b665b);font-size:12px;}"
    },
    {
      "name": "Revision component strip",
      "kind": "custom",
      "refersTo": "revision-component",
      "description": "The signature component evidence pattern pairs a generation notice with wrapping technical identifiers.",
      "html": "<section class=\"ds-revision-panel\" aria-label=\"Example selected revision\"><div class=\"ds-revision-notice\">Observed 17s ago for generation 1.<span>Generation 1</span></div><div class=\"ds-revision-strip\"><div class=\"ds-revision-component\"><div class=\"ds-revision-heading\"><h3>api</h3><span class=\"ds-revision-status\"><span class=\"ds-revision-dot\" aria-hidden=\"true\"></span>Ready</span></div><p>http · ReconciliationSucceeded</p><code>sha256:0123456789ab</code></div><div class=\"ds-revision-component\"><div class=\"ds-revision-heading\"><h3>web</h3><span class=\"ds-revision-status\"><span class=\"ds-revision-dot\" aria-hidden=\"true\"></span>Ready</span></div><p>http · ReconciliationSucceeded</p><code>sha256:0123456789ab</code><p>After api</p></div></div></section>",
      "css": ".ds-revision-panel{max-width:620px;overflow:hidden;border:1px solid var(--border,#d6ddce);border-radius:12px;background:var(--card,#fdfdf8);color:var(--foreground,#222a25);font:400 14px/21px \"Figtree Variable\",sans-serif;}.ds-revision-notice{display:flex;align-items:center;flex-wrap:wrap;gap:10px;padding:12px 16px;border-bottom:1px solid var(--border,#d6ddce);background:var(--muted,#edf0e5);font-size:13px;}.ds-revision-notice span{margin-left:auto;font-size:12px;color:var(--muted-foreground,#5b665b);}.ds-revision-strip{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));}.ds-revision-component{display:flex;flex-direction:column;gap:11px;min-width:0;padding:18px 16px;border-right:1px solid var(--border,#d6ddce);}.ds-revision-component:last-child{border-right:0;}.ds-revision-component h3{margin:0;font-size:14px;font-weight:650;letter-spacing:-.025em;}.ds-revision-component p{margin:0;font-size:12px;color:var(--muted-foreground,#5b665b);}.ds-revision-component code{overflow-wrap:anywhere;font:400 12px/18px ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;}@media(max-width:760px){.ds-revision-strip{grid-template-columns:1fr;}.ds-revision-component{border-right:0;border-bottom:1px solid var(--border,#d6ddce);}.ds-revision-component:last-child{border-bottom:0;}}.ds-revision-heading{display:flex;align-items:center;justify-content:space-between;gap:8px;}.ds-revision-status{display:inline-flex;align-items:center;justify-content:center;gap:4px;height:20px;padding:2px 8px;border:1px solid transparent;border-radius:32px;white-space:nowrap;color:var(--success,#237043);background:var(--success-surface,#e8f1e7);font:500 12px/16px \"Figtree Variable\",sans-serif;}.ds-revision-dot{width:5px;height:5px;border-radius:50%;background:currentColor;}"
    },
    {
      "name": "CSS brand geometry",
      "kind": "custom",
      "refersTo": "brand-mark",
      "description": "The shipping Keldock mark uses two CSS bars beside the locally loaded wordmark; no raster asset.",
      "html": "<a class=\"ds-brand\" href=\"#keldock\" aria-label=\"Keldock home\"><span class=\"ds-brand-mark\" aria-hidden=\"true\"><i></i><i></i></span>Keldock</a>",
      "css": ".ds-brand{display:flex;align-items:center;gap:12px;width:fit-content;padding:0 12px;background:var(--rail,#213d32);color:var(--rail-foreground,#eff3e9);font:650 26px/39px \"Figtree Variable\",sans-serif;letter-spacing:-.035em;text-decoration:none;}.ds-brand-mark{display:flex;align-items:flex-end;gap:4px;width:23px;height:25px;}.ds-brand-mark i{width:8px;height:25px;border-radius:2px;background:#d8e1ce;}.ds-brand-mark i:last-child{height:16px;background:#e8a28a;}.ds-brand:focus-visible{outline:2px solid var(--ring,#8b4e37);outline-offset:3px;}"
    }
  ],
  "narrative": {
    "northStar": "Field Guide",
    "overview": "Field Guide describes the implemented console: a forest navigation rail frames a pale, green-tinted workspace; compact records, clear headings and restrained controls keep deployment evidence readable. It is a provisional descriptive direction used after an unanswered preview, not a user-approved visual identity. The code and reviewed screens govern the rules below.\n\nThe durable product constraint is factual, revision-aware communication. Health, freshness, permissions and recoverable actions remain legible in both themes. Administration reuses the same typography, controls and surfaces; authentication gives the forest surface more space without introducing a second identity.",
    "keyCharacteristics": [
      "Forest navigation and green-tinted neutral surfaces.",
      "Compact tabular records with labeled semantic health.",
      "Locally sourced Figtree with monospace technical evidence.",
      "Flat persistent surfaces and restrained temporary elevation.",
      "Responsive evidence that wraps without hiding fixture provenance."
    ],
    "rules": [
      {
        "name": "The Paired Status Rule",
        "body": "Health uses a named state, a dot and its foreground/surface pair; preserve the accompanying evidence or freshness text.",
        "section": "colors"
      },
      {
        "name": "The Evidence Type Rule",
        "body": "Use monospace for revisions, hashes, callback addresses and resource identifiers, and Figtree for names, state labels and prose.",
        "section": "typography"
      },
      {
        "name": "The Flat Record Rule",
        "body": "Persistent records use tone and fine borders; temporary selection menus and navigation sheets use their implemented elevation.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the semantic CSS variables so light and dark themes retain paired contrast.",
      "Do retain visible focus, meaningful labels and text alongside health color.",
      "Do allow full diagnostic hashes, endpoints and resource identifiers to wrap on narrow screens.",
      "Do preserve visible synthetic-fixture provenance at mobile and desktop widths.",
      "Do reuse the local Figtree asset, CSS brand geometry and Lucide SVG icons."
    ],
    "donts": [
      "Don't infer readiness from a successful submission or stale observation.",
      "Don't add shadows to persistent tables, evidence panels or administration lists.",
      "Don't replace labeled health with color alone or clip full diagnostic evidence.",
      "Don't promote this provisional direction or the code-led sketch to user-approved identity."
    ]
  }
}
